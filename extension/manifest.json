{
  "manifest_version": 3,
  "name": "Grow GEO — Agent Readability Score",
  "version": "1.0.0",
  "description": "One-click GEO score for any site. See how AI agents read the page you're on.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://grow.contact/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grow GEO Score",
    "default_icon": { "48": "icon.png", "128": "icon.png" }
  },
  "icons": { "48": "icon.png", "128": "icon.png" }
}
